@model IEnumerable<TimeKeeping.Application.ViewModels.ChamCongCheckInOutV1ViewModel.ChamCongCheckInOutV1GetViewModel>

@{
    ViewData["Title"] = "Giải trình chấm công và báo cáo";
    var stt = 1;
}

<div class="container">
    <p class="border-bottom mb-5">Quản trị/Dữ liệu chấm công</p>
    <h5 class="text-center" style="color: #ef4e24"><strong>THÔNG TIN CHUNG</strong></h5>
    <table class="table table-bordered" style="border-color:#00bfff">
        <thead class="text-center" style="background-color: lightgray">
            <tr>
                <th>STT</th>
                <th>Mã chấm công</th>
                <th>Họ tên</th>
                <th>Chức danh</th>
                <th>Đơn vị</th>
                <th>Ngày chấm</th>
                <th>Giờ chấm</th>
                <th>Tên máy</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.MaNhanVien</td>
                        <td>@item.NgayCham?.ToString("dd/MM/yyyy")</td>
                        <td>@item.GioCham?.ToString("HH:mm:ss")</td>
                        <td>@item.KieuCham</td>
                        <td>@item.NguonCham</td>
                        <td>@item.MaSoMay</td>
                        <td>@item.TenMay</td>
                    </tr>
                    stt++;
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-danger">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>
