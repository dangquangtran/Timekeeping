@model IEnumerable<TimeKeeping.Application.ViewModels.LyDoViPhamViewModel.LyDoViPhamGetViewModel>

@{
    var stt = 1;
}

<div class="container">
    <p class="border-bottom mb-5">Trang chủ</p>
    <h5 class="text-center" style="color: #ef4e24"><strong>THÔNG TIN CHUNG</strong></h5>
    <table class="table table-bordered table-hover" style="border-color:#00bfff">
        <thead class="text-center" style="background-color: lightgray">
            <tr>
                <th>STT</th>
                <th>Lý do vi phạm chấm công</th>
                <th>Kèm file</th>
                <th>Ghi nhận</th>
                <th>Ghi chú</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@stt</td>
                        <td>@item.tenlydo</td>
                        <td>@(item.kemfile == 1 ? "Có" : "Không")</td>
                        <td>@(item.ghinhan == 1 ? "Vi phạm" : "Không vi phạm")</td>
                        <td>@item.ghichu</td>
                    </tr>
                    stt++;
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-danger">Không có dữ liệu</td>
                </tr>
            }
        </tbody>
    </table>
</div>
