@model TimeKeeping.Application.ViewModels.BaoCaokiViewModel.KyBaoCaoPageViewModel

<link rel="stylesheet" href="~/css/ky-bao-cao.css" asp-append-version="true" />
<div class="container">
    <p class="border-bottom mb-5">Cập nhật/Kỳ báo cáo</p>
    <h4 class="text-center" style="color: #ef4e24"><strong>CẬP NHẬT KỲ BÁO CÁO</strong></h4>
    <div class="row d-flex">
        <div class="col-md-4">
            <form asp-controller="BaoCaoki" asp-action="CreateBaoCaoKi" method="post" class="text-start border p-3 rounded bg-light form-create">
                <h5 style="color: #00bfff"><strong>Thêm kỳ báo cáo</strong></h5>
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                <div class="mb-2">
                    <label class="form-label">Tên kỳ</label>
                    <input asp-for="CreateModel.tenky" class="form-control" />
                    <span asp-validation-for="CreateModel.tenky" class="text-danger"></span>
                </div>
                <div class="mb-2">
                    <label class="form-label">Từ ngày</label>
                    <input asp-for="CreateModel.tungay" class="form-control" type="date" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Đến ngày</label>
                    <input asp-for="CreateModel.denngay" class="form-control" type="date" required />
                </div>
                <div class="mb-2">
                    <label class="form-label">Ngày đóng giải trình</label>
                    <input asp-for="CreateModel.ngaydong_giaitrinh" class="form-control" type="date" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Ngày duyệt</label>
                    <input asp-for="CreateModel.ngay_duyet" class="form-control" type="date" />
                </div>
                <div class="mb-2">
                    <label class="form-label">Ngày tự động đóng</label>
                    <input asp-for="CreateModel.ngaydong_auto" class="form-control" type="date" />
                </div>
                <div class="btn-group">
                    <button type="submit" class="btn btn-primary w-100">XÁC NHẬN</button>
                    <button type="reset" class="btn-reset">LÀM MỚI</button>
                </div>
                <input type="hidden" asp-for="PageIndex" />
                <input type="hidden" asp-for="PageSize" />
            </form>
        </div>
        <div class="col-md-8">
            <h5 style="color: #00bfff"><strong>Danh sách kỳ báo cáo</strong></h5>
            <div class="d-flex justify-content-end align-items-center mb-2">
                <p class="mb-0">Chọn số dòng</p>
                <form method="get" asp-action="KyBaoCao" class="d-flex justify-content-end align-items-center" style="gap:8px">
                    <select name="pageSize" class="form-select w-auto ms-2" onchange="this.form.submit()">
                                        <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                                        <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
                                        <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                                        <option value="100" selected="@(Model.PageSize == 100 ? "selected" : null)">100</option>

                    </select>
                    <input type="hidden" name="pageIndex" value="1" />
                </form>

            </div>
            <table class="table table-bordered table-hover" style="border-color:#00bfff">
                <thead class="text-center justify-content-center" style="background-color: lightgray">
                <tr class="align-middle">
                        <th rowspan="2">STT</th>
                        <th rowspan="2">Tên kỳ</th>
                        <th colspan="2">Thời gian</th>
                        <th rowspan="2">Trạng thái</th>
                        <th rowspan="2">Ngày đóng giải trình</th>
                        <th rowspan="2">Ngày duyệt</th>
                        <th rowspan="2">Ngày tự động đóng</th>
                    </tr>
                    <tr>
                        <th>Từ ngày</th>
                        <th>Đến ngày</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.List != null && Model.List.Any())
                    {
                        var stt = 1;
                        foreach (var item in Model.List)
                        {
                            <tr>
                                <td>@stt</td>
                                <td>@item.tenky</td>
                                <td>@item.tungay?.ToString("dd/MM/yyyy")</td>
                                <td>@item.denngay?.ToString("dd/MM/yyyy")</td>
                                <td>@item.TrangThai</td>
                                <td>@item.ngaydong_giaitrinh?.ToString("dd/MM/yyyy")</td>
                                <td>@item.ngay_duyet?.ToString("dd/MM/yyyy")</td>
                                <td>@item.ngaydong_auto?.ToString("dd/MM/yyyy")</td>
                            </tr>
                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-danger">Không có dữ liệu</td>
                        </tr>
                    }
                </tbody>

            </table>

            <div class="custom-pagination-wrapper">
                <form method="get" asp-action="KyBaoCao" class="custom-pagination">
                    <input type="hidden" name="pageSize" value="@Model.PageSize" />
                    <button class="custom-page-btn" name="pageIndex" value="1" @(Model.PageIndex == 1 ? "disabled" : "") title="Trang đầu">&laquo;|</button>
                    <button class="custom-page-btn" name="pageIndex" value="@(Model.PageIndex - 1)" @(Model.PageIndex == 1 ? "disabled" : "") title="Trang trước">&lsaquo;</button>
                    <span class="custom-page-info">@Model.PageIndex/@Model.TotalPages</span>
                    <button class="custom-page-btn" name="pageIndex" value="@(Model.PageIndex + 1)" @(Model.PageIndex == Model.TotalPages ? "disabled" : "") title="Trang sau">&rsaquo;</button>
                    <button class="custom-page-btn" name="pageIndex" value="@Model.TotalPages" @(Model.PageIndex == Model.TotalPages ? "disabled" : "") title="Trang cuối">|&raquo;</button>
                </form>
            </div>


        </div>
    </div>
</div>
